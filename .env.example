# Copy to .env and fill in. `make dev` refuses to start without SECRET_KEY.

ENVIRONMENT=local
# openssl rand -hex 32
SECRET_KEY=

# --- database ---
POSTGRES_USER=tendersense
POSTGRES_PASSWORD=tendersense
POSTGRES_DB=tendersense
POSTGRES_PORT_HOST=5432

# --- host ports (local only) ---
# Change API_PORT_HOST if something else already listens on 8000, and set
# frontend/.env.local VITE_API_PROXY_TARGET to match.
API_PORT_HOST=8000
REDIS_PORT_HOST=6379
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
HTTP_PORT=8080
HTTPS_PORT=8443

# --- URLs ---
# Origin the SPA is actually served from. Every link in an email (verification,
# password reset, invitation, unsubscribe) is built from it, so a wrong value
# sends people to a port that is not listening.
#   `make fe-dev` (Vite dev server):  http://localhost:5173
#   `make dev` only (Caddy serves the built SPA): http://localhost:${HTTP_PORT}
APP_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173
# Set for production TLS in infra/caddy/Caddyfile
DOMAIN=

# --- email (Mailpit locally; real SMTP in production) ---
# EMAIL_FROM must be a domain whose SPF record lists the relay below. A
# mismatch sends successfully and is never delivered, which is the single most
# common cause of "the digest never arrived".
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
EMAIL_FROM=TenderSense <no-reply@tendersense.local>
EMAIL_REPLY_TO=

# --- AI ---
# gemini | fake  ("fake" runs the whole pipeline offline with deterministic stubs)
AI_PROVIDER=fake
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
GENERATION_MODEL=gemini-3.1-flash-lite

# --- Google sign-in (optional until M1) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- observability ---
LOG_LEVEL=INFO
# Errors go nowhere unless this is set. Events are scrubbed of tokens and keys
# before they leave the process.
SENTRY_DSN=
# Reported with each event so a regression can be tied to a deploy.
RELEASE=

# --- housekeeping ---
# Run records, in-app notifications, and the send ledger. The ledger must
# outlive the longest reminder offset by a wide margin: deleting a ledger row
# is what makes a message sendable again.
JOB_RUN_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=90
LEDGER_RETENTION_DAYS=180

# Daily model token cap. 0 means unlimited; an exhausted budget degrades
# explanations to the templated ones rather than losing matches.
AI_DAILY_TOKEN_BUDGET=2000000
