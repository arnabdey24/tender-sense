# Copy to .env and fill in. `make dev` refuses to start without SECRET_KEY.

ENVIRONMENT=local
# openssl rand -hex 32
SECRET_KEY=

# --- database ---
POSTGRES_USER=tendersense
POSTGRES_PASSWORD=tendersense
POSTGRES_DB=tendersense
POSTGRES_PORT_HOST=5432

# --- host ports (local only) ---
# Change API_PORT_HOST if something else already listens on 8000, and set
# frontend/.env.local VITE_API_PROXY_TARGET to match.
API_PORT_HOST=8000
REDIS_PORT_HOST=6379
HTTP_PORT=8080
HTTPS_PORT=8443

# --- URLs ---
# Origin the SPA is actually served from. Every link in an email (verification,
# password reset, invitation, unsubscribe) is built from it, so a wrong value
# sends people to a port that is not listening.
#   `make fe-dev` (Vite dev server):  http://localhost:5173
#   `make dev` only (Caddy serves the built SPA): http://localhost:${HTTP_PORT}
APP_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173
# Set for production TLS in infra/caddy/Caddyfile
DOMAIN=

# --- email (Gmail SMTP, the same relay locally and in production) ---
# SMTP_PASSWORD is a 16-character App Password from
# https://myaccount.google.com/apppasswords — not the account password. The
# account needs 2-step verification on before that page will issue one.
#
# Google rewrites From to SMTP_USER unless EMAIL_FROM is an address the account
# is verified to send as (Gmail → Settings → Accounts → "Send mail as"). Set
# EMAIL_FROM to the mailbox itself unless you have done that; a mismatch is the
# single most common cause of "the digest arrived from the wrong address".
#
# Sending caps are real: roughly 500 messages/day on a consumer account and
# 2,000 on Workspace, counted per recipient. Past that Google returns a
# temporary failure and the outbox retries against a wall.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
# How long a message may sit in `sending` before the pump assumes the worker
# that claimed it died and puts it back. Workers restart on every deploy, so
# without this an in-flight message is stranded in a state nothing retries,
# nothing lists and no button can rescue.
EMAIL_STALLED_AFTER_MINUTES=15
EMAIL_FROM=TenderSense <you@yourdomain.com>
EMAIL_REPLY_TO=

# --- AI ---
# gemini | fake  ("fake" runs the whole pipeline offline with deterministic stubs)
AI_PROVIDER=gemini
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
GENERATION_MODEL=gemini-3.1-flash-lite

# Reading a company's website to draft its profile. A different job from bulk
# extraction: it runs once per company, reads live pages through the provider's
# own fetcher, and its output is read word for word by the person it describes,
# so it gets the stronger model. RESEARCH_MAX_OUTPUT_TOKENS is not a tuning
# knob — uncapped, the model re-fetched one page twenty-four times and
# terminated with TOO_MANY_TOOL_CALLS and an empty body.
RESEARCH_MODEL=gemini-3.8-flash
RESEARCH_MAX_OUTPUT_TOKENS=4096
# Rewriting one field is frequent, small and cheap, so it keeps the lite model.
WRITING_MODEL=gemini-3.1-flash-lite

# Tender conversations. Fake AI provides labeled demos and a voice animation preview.
ASSISTANT_ENABLED=true
ASSISTANT_VOICE_ENABLED=false
# Live voice opens a WebSocket, and the handshake rejects any Origin not listed in
# APP_URL or BACKEND_CORS_ORIGINS. A dev server on a different port must be added
# there or voice fails the handshake with a 403 while text chat keeps working.
ASSISTANT_MODEL=gemini-3.1-flash-lite
ASSISTANT_VOICE_MODEL=gemini-3.1-flash-live-preview
# Prebuilt Live voice. Aoede is warm and unhurried; Kore is firmer, Leda
# younger, Zephyr brighter, Puck the male-sounding default.
ASSISTANT_VOICE_NAME=Aoede
# Languages the speech recogniser may transcribe into. Unset, it auto-detects
# across everything it knows and returns Bangla speech as Hindi in Devanagari.
ASSISTANT_VOICE_LANGUAGES=bn-BD,en-US
# TenderSense's own daily guard rails, not the provider's quota. They exist so a
# runaway loop cannot spend an API key's balance. Set either to 0 to disable it
# and rely on the billing limits configured on the key itself.
ASSISTANT_DAILY_TURN_LIMIT=100
ASSISTANT_DAILY_VOICE_SECONDS=3600
ASSISTANT_VOICE_MAX_SECONDS=600
ASSISTANT_RETENTION_DAYS=90

# --- Google sign-in (optional until M1) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- observability ---
LOG_LEVEL=INFO
# Errors go nowhere unless this is set. Events are scrubbed of tokens and keys
# before they leave the process.
SENTRY_DSN=
# The released version this host runs, as the git tag (v1.0.0). Set by
# scripts/deploy.sh from the tag it checked out and reported with every Sentry
# event, so an error can be tied to a deploy. deploy.sh also derives IMAGE_TAG
# from it (v1.0.0 -> 1.0.0), which is what the production overlay pulls.
RELEASE=
# Where the release pipeline publishes images. Change it if the repository moves.
IMAGE_PREFIX=ghcr.io/arnabdey24/tender-sense

# --- housekeeping ---
# Run records, in-app notifications, and the send ledger. The ledger must
# outlive the longest reminder offset by a wide margin: deleting a ledger row
# is what makes a message sendable again.
JOB_RUN_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=90
LEDGER_RETENTION_DAYS=180

# Daily model token cap. 0 means unlimited; an exhausted budget degrades
# explanations to the templated ones rather than losing matches.
AI_DAILY_TOKEN_BUDGET=2000000
# Pipeline throughput. One limiter per process; a tender costs ~6 requests
# (extraction + one per chunk + one per explanation). The default is sized for
# a free-tier key — raise it to what yours allows or the queue backs up.
AI_REQUESTS_PER_MINUTE=12
AI_MAX_CONCURRENCY=5

# --- running the backend outside Docker (IDE run config, or `uv run uvicorn`) ---
# Compose hardcodes POSTGRES_HOST=db, REDIS_HOST=redis and the blob path for
# containers, so these three are read only when the API runs on the host. They
# are what makes `uv run uvicorn app.main:app --reload --port 8020` work from
# backend/ with no environment variables on the command line.
POSTGRES_HOST=localhost
REDIS_HOST=localhost
BLOB_STORAGE_DIR=./.local/blobs
