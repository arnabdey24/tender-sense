{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import button %}
{% block preheader %}{{ total_count }} new match{{ "es" if total_count != 1 }} since your last shortlist.{% endblock %}
{% block content %}
<h1 style="margin: 0 0 6px; font-size: 20px; line-height: 28px; color: #16233c;">Your shortlist for {{ digest_date }}</h1>
<p style="margin: 0 0 20px; font-size: 14px; color: #79828f;">{{ total_count }} new match{{ "es" if total_count != 1 }} for {{ organization_name }}.</p>

{% if picks %}
<p style="margin: 0 0 10px; font-weight: 600;">Worth your attention</p>
{% for pick in picks %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width: 100%; margin: 0 0 12px; border: 1px solid #e2e6ec; border-radius: 6px;">
  <tr>
    <td style="padding: 14px 16px;">
      <p style="margin: 0 0 4px; font-size: 12px; letter-spacing: 0.4px; text-transform: uppercase; color: #79828f;">Grade {{ pick.grade }} &middot; {{ pick.eligibility_label }}</p>
      <p style="margin: 0 0 6px; font-size: 15px; font-weight: 600; line-height: 22px;"><a href="{{ pick.url }}" style="color: #16233c; text-decoration: none;">{{ pick.title }}</a></p>
      <p style="margin: 0 0 6px; font-size: 13px; line-height: 20px; color: #5b6472;">{{ pick.summary }}</p>
      <p style="margin: 0; font-size: 12px; color: #79828f;">{{ pick.procuring_entity or "Buyer not stated" }} &middot; closes {{ pick.deadline_label }}</p>
    </td>
  </tr>
</table>
{% endfor %}
{% endif %}

{% if needs_verification %}
<p style="margin: 18px 0 10px; font-weight: 600;">Needs a human check</p>
<p style="margin: 0 0 8px; font-size: 13px; line-height: 20px; color: #5b6472;">A hard rule could not be decided from the notice, so these are not rejections.</p>
<ul style="margin: 0 0 8px; padding-left: 20px;">
  {% for item in needs_verification %}
  <li style="margin: 0 0 6px; font-size: 14px; line-height: 21px;"><a href="{{ item.url }}" style="color: #1b4fd8;">{{ item.title }}</a> — {{ item.reason }}</li>
  {% endfor %}
</ul>
{% endif %}

{% if upcoming_deadlines %}
<p style="margin: 18px 0 10px; font-weight: 600;">Bids you are working on</p>
<ul style="margin: 0 0 8px; padding-left: 20px;">
  {% for item in upcoming_deadlines %}
  <li style="margin: 0 0 6px; font-size: 14px; line-height: 21px;"><a href="{{ item.url }}" style="color: #1b4fd8;">{{ item.title }}</a> — closes {{ item.deadline_label }}</li>
  {% endfor %}
</ul>
{% endif %}

{% if other_count %}
<p style="margin: 18px 0 0; font-size: 14px; color: #5b6472;">{{ other_count }} further match{{ "es" if other_count != 1 }} did not make the cut for this email.</p>
{% endif %}

{% if setup_nudge %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width: 100%; margin: 20px 0 0; background-color: #fbf7ec; border: 1px solid #f0e3c4; border-radius: 6px;">
  <tr><td style="padding: 14px 16px; font-size: 13px; line-height: 20px; color: #6a5518;">{{ setup_nudge }}</td></tr>
</table>
{% endif %}

{{ button(app_url ~ "/app/today", "Open today's shortlist") }}
{% endblock %}
{% block footer %}
<p style="margin: 0 0 6px; font-size: 12px; line-height: 19px; color: #79828f;">Sent to {{ recipient_name }} as part of {{ organization_name }}'s daily shortlist. <a href="{{ unsubscribe_url }}" style="color: #79828f;">Unsubscribe</a>.</p>
{% endblock %}
