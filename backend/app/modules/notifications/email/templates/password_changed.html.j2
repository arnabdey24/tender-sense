{% extends "_base.html.j2" %}
{% block preheader %}Security notice: the password on your {{ app_name }} account was changed.{% endblock %}
{% block content %}
<h1 style="margin: 0 0 18px; font-size: 21px; line-height: 28px; font-weight: 600; color: #16233c;">Your password was changed</h1>
<p style="margin: 0 0 16px;">Hi {{ user_name }},</p>
<p style="margin: 0 0 16px;">The password for your {{ app_name }} account was changed on <strong>{{ changed_at }}</strong>. You are still signed in on this device; every other session has been signed out.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 22px 0;">
  <tr>
    <td style="padding: 14px 16px; background-color: #fff8e6; border-left: 3px solid #e0a300; border-radius: 4px;">
      <p style="margin: 0; font-size: 14px; line-height: 22px; color: #5a4200;"><strong>Didn't do this?</strong> Someone else may have access to your account. Reset your password immediately and contact us at <a href="mailto:{{ support_email }}" style="color: #5a4200;">{{ support_email }}</a>.</p>
    </td>
  </tr>
</table>
<p style="margin: 0; color: #5b6472;">If you made this change, no further action is needed. We send this notice every time an account password changes.</p>
{% endblock %}
