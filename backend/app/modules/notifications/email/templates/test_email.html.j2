{% extends "_base.html.j2" %}
{% block preheader %}Delivery is working.{% endblock %}
{% block content %}
<h1 style="margin: 0 0 14px; font-size: 20px; line-height: 28px; color: #16233c;">Delivery is working</h1>
<p style="margin: 0 0 16px;">{{ triggered_by }} sent this from {{ organization_name }}'s notification settings to check that {{ app_name }} mail reaches this address.</p>
<p style="margin: 0; font-size: 13px; color: #79828f;">If it landed in spam, that is worth fixing before the first real alert arrives — a shortlist nobody sees is the same as no shortlist.</p>
{% endblock %}
